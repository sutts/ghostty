using Gtk 4.0;
using Gdk 4.0;
using Adw 1;

// The working directory and git boxes live in info_row for the portrait and
// banner styles and are moved into rail_row for the rail style.
template $GhosttySplitHeader: Adw.Bin {
  styles [
    "split-header",
  ]

  // See surface.blp for why we need to wrap this.
  Adw.Bin {
    Box {
      orientation: vertical;

      Box danger_strip {
        styles [
          "danger-strip",
        ]

        visible: false;
        orientation: horizontal;
        spacing: 6;

        Image {
          icon-name: "dialog-warning-symbolic";
          pixel-size: 12;
        }

        Label danger_label {
          xalign: 0.0;
          hexpand: true;
          ellipsize: end;
          single-line-mode: true;
        }
      }

      Box {
        styles [
          "split-header-top",
        ]

        orientation: horizontal;
        spacing: 10;

        Overlay {
          valign: center;

          child: Button avatar_button {
            styles [
              "flat",
              "avatar-button",
            ]

            focusable: false;
            focus-on-click: false;
            overflow: hidden;
            tooltip-text: _("Choose Avatar");
            clicked => $avatar_clicked();

            cursor: Gdk.Cursor {
              name: "pointer";
            };

            Image avatar_image {
              icon-name: "avatar-default-symbolic";
              pixel-size: 44;
            }
          };

          [overlay]
          Box avatar_fade {
            styles [
              "avatar-fade",
            ]

            visible: false;
            can-focus: false;
            can-target: false;
            focusable: false;
          }
        }

        Box {
          orientation: vertical;
          valign: center;
          hexpand: true;
          spacing: 3;

          // The controls share a row with the title so they line up with
          // it rather than floating between the title and the info row.
          Box title_row {
            orientation: horizontal;
            spacing: 6;

            Button title_button {
              styles [
                "flat",
                "title-button",
              ]

              halign: start;
              hexpand: true;
              focusable: false;
              focus-on-click: false;
              clicked => $title_clicked();
              tooltip-text: _("Click to rename");

              cursor: Gdk.Cursor {
                name: "pointer";
              };

              child: Label title_label {
                styles [
                  "title-label",
                ]

                xalign: 0.0;
                ellipsize: end;
                single-line-mode: true;
              };
            }

            Box {
              styles [
                "header-controls",
                "linked",
              ]

              valign: center;

              Button expand_button {
                styles [
                  "flat",
                ]

                icon-name: "view-fullscreen-symbolic";
                tooltip-text: _("Expand Block (Overlay)");
                focusable: false;
                focus-on-click: false;
                clicked => $expand_clicked();

                cursor: Gdk.Cursor {
                  name: "pointer";
                };
              }

              Button danger_button {
                styles [
                  "flat",
                ]

                icon-name: "dialog-warning-symbolic";
                tooltip-text: _("Mark Split as Dangerous");
                focusable: false;
                focus-on-click: false;
                clicked => $danger_clicked();

                cursor: Gdk.Cursor {
                  name: "pointer";
                };
              }

              Button theme_button {
                styles [
                  "flat",
                ]

                icon-name: "preferences-desktop-appearance-symbolic";
                tooltip-text: _("Terminal Theme");
                focusable: false;
                focus-on-click: false;
                clicked => $theme_clicked();

                cursor: Gdk.Cursor {
                  name: "pointer";
                };
              }

              Button style_button {
                styles [
                  "flat",
                ]

                icon-name: "view-dual-symbolic";
                focusable: false;
                focus-on-click: false;
                clicked => $cycle_style();

                cursor: Gdk.Cursor {
                  name: "pointer";
                };
              }

              Button smaller_button {
                styles [
                  "flat",
                ]

                icon-name: "list-remove-symbolic";
                tooltip-text: _("Smaller Header");
                focusable: false;
                focus-on-click: false;
                clicked => $header_smaller();

                cursor: Gdk.Cursor {
                  name: "pointer";
                };
              }

              Button larger_button {
                styles [
                  "flat",
                ]

                icon-name: "list-add-symbolic";
                tooltip-text: _("Larger Header");
                focusable: false;
                focus-on-click: false;
                clicked => $header_larger();

                cursor: Gdk.Cursor {
                  name: "pointer";
                };
              }
            }
          }

          Box info_row {
            orientation: horizontal;
            spacing: 14;

            Box host_box {
              styles [
                "info-pill",
                "host-box",
              ]

              spacing: 5;

              Image host_icon {
                styles [
                  "dim",
                ]

                icon-name: "computer-symbolic";
                pixel-size: 12;
              }

              Label host_label {
                styles [
                  "dim",
                  "mono",
                ]

                xalign: 0.0;
                ellipsize: end;
                single-line-mode: true;
              }
            }

            Button pwd_box {
              styles [
                "info-pill",
                "flat",
                "pwd-box",
                "pwd-button",
              ]

              focusable: false;
              focus-on-click: false;
              clicked => $pwd_clicked();
              tooltip-text: _("Open in file manager");

              cursor: Gdk.Cursor {
                name: "pointer";
              };

              child: Box {
                spacing: 5;

                Image pwd_icon {
                  styles [
                    "dim",
                  ]

                  icon-name: "folder-symbolic";
                  pixel-size: 12;
                }

                Label pwd_label {
                  styles [
                    "dim",
                    "mono",
                  ]

                  xalign: 0.0;
                  ellipsize: start;
                  single-line-mode: true;
                }
              };
            }

            Box git_box {
              hexpand: true;
              halign: end;
              spacing: 8;

              Button branch_box {
                styles [
                  "info-pill",
                  "flat",
                  "branch-button",
                ]

                visible: false;
                focusable: false;
                focus-on-click: false;
                clicked => $branch_clicked();
                tooltip-text: _("Open pull/merge request, or branch");

                cursor: Gdk.Cursor {
                  name: "pointer";
                };

                child: Box {
                  spacing: 5;

                  Label {
                    styles [
                      "dim",
                    ]

                    label: "⎇";
                  }

                  Label branch_label {
                    styles [
                      "mono",
                    ]

                    ellipsize: end;
                    max-width-chars: 32;
                    single-line-mode: true;
                  }
                };
              }

              Button stats_box {
                styles [
                  "info-pill",
                  "flat",
                  "stats-button",
                ]

                visible: false;
                focusable: false;
                focus-on-click: false;
                clicked => $stats_clicked();
                tooltip-text: _("Open diff against main in your difftool");

                cursor: Gdk.Cursor {
                  name: "pointer";
                };

                child: Box {
                  spacing: 5;

                  Label files_label {
                    styles [
                      "dim",
                      "mono",
                    ]
                  }

                  Label add_label {
                    styles [
                      "mono",
                      "diff-add",
                    ]
                  }

                  Label del_label {
                    styles [
                      "mono",
                      "diff-del",
                    ]
                  }

                  Label untracked_label {
                    styles [
                      "dim",
                      "mono",
                    ]
                  }
                };
              }
            }
          }
        }
      }

      Box rail_row {
        styles [
          "split-header-rail",
        ]

        visible: false;
        orientation: horizontal;
        spacing: 14;
      }
    }
  }
}
